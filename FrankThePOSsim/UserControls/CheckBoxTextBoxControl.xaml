<UserControl x:Class="FrankThePOSsim.UserControls.CheckBoxTextBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <system:String x:Key="CurlyBracesString">{ }</system:String>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="CheckBoxControlGroup" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition SharedSizeGroup="ControlGroupHeight" />
        </Grid.RowDefinitions>
            
        <StackPanel Orientation="Horizontal" Grid.Column="0">
            <CheckBox x:Name="CheckBox" IsChecked="{Binding IsChecked}">
                <TextBlock Text="{Binding Header}" />
            </CheckBox>
        </StackPanel>

        <DockPanel Grid.Column="1" LastChildFill="True">
            <!-- Button2 docked to the right -->
            <ContentControl Visibility="{Binding Button2Visibility}"
                            DockPanel.Dock="Right">
                <Button Height="26" Width="26" Click="Button2_Click" Padding="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Button2TextContent"
                                   Text="{Binding Button2Text}" 
                                   Visibility="{Binding Button2Type, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Text'}" />
                        <Image x:Name="Button2ImageContent"
                               wpf:Image.Source="{Binding Button2Image}" 
                               Visibility="{Binding Button2Type, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Image'}" />
                    </StackPanel>
                </Button>
            </ContentControl>

            <!-- Button1 docked to the right -->
            <ContentControl Visibility="{Binding Button1Visibility}"
                            DockPanel.Dock="Right">
                <Button Height="26" Width="26" Click="Button1_Click" Padding="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Button1TextContent"
                                   Text="{Binding Button1Text}" 
                                   Visibility="{Binding Button1Type, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Text'}" />
                        <Image x:Name="Button1ImageContent"
                               wpf:Image.Source="{Binding Button1Image}" 
                               Visibility="{Binding Button1Type, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter='Image'}" />
                    </StackPanel>
                </Button>
            </ContentControl>

            <!-- TextBox fills the remaining space -->
            <TextBox VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsChecked, ElementName=CheckBox}"
                     Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
    </Grid>
</UserControl>